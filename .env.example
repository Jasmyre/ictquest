# Never leak environment variable values!

BASE_URL=

# Database variables
# DATABASE_URL is production (live user data). Never point it at dev/test.
DATABASE_URL=
# Development database (prisma migrate dev, local runs). Falls back to
# DATABASE_URL when unset.
DATABASE_URL_DEV=
# Test database (CI integration runs, ephemeral). Falls back to DATABASE_URL
# when unset; CI sets it from the postgres service.
DATABASE_URL_TEST=

# Google site console
GOOGLE_SITE_VERIFICATION=

# Auth
AUTH_SECRET=
NEXTAUTH_URL=

# Github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# KV
KV_REST_API_TOKEN=
KV_REST_API_URL=

# Others
NEXT_PUBLIC_IS_IN_MAINTENANCE=